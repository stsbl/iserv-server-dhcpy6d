--- /usr/lib/dhcpcd/dhcpcd-hooks/70-dhcpy6d
+++ /usr/lib/dhcpcd/dhcpcd-hooks/70-dhcpy6d
@@ -14,13 +14,13 @@
     value="$1"
     tmp="$(mktemp)"
     if [ -n "${value}" ]; then
-        printf 'PREFIX_OPT=--prefix\nPREFIX_VAL=%s\n' "${value}" > "${tmp}"
+        printf 'PREFIX_OPT=--prefix\nPREFIX_VAL=%s\nPREFIX_SOURCE=%s\n' "${value}" "${interface:-}" > "${tmp}"
     else
